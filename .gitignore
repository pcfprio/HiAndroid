# Compiled class file
*.class

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
*.hprof

# HiAndroid generated files
# Gradle 与 Kotlin 构建缓存、所有模块的 build 目录。
.gradle/
.kotlin/
build/
out/
**/bin/

# Android 本地环境与原生构建输出。
local.properties
.externalNativeBuild/
.cxx/
captures/

# Android Studio、VS Code 与 IntelliJ IDEA 本地文件。
.idea/
.vscode/
*.iml

# macOS、本地辅助工具与日志文件。
.DS_Store
._*
*.log
/.codegraph/
/.claude/worktrees/
/.claude/settings.local.json
temp/

# 本地环境配置、签名文件和私钥文件。
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.jks
*.keystore
*.p12
*.pem
secring.gpg

# Gradle Wrapper JAR 是可复现构建的必要文件，必须提交。
!gradle/wrapper/gradle-wrapper.jar

# 友盟 SMS/Email 尚未提供 Maven 依赖，按官方离线集成要求随可选模块分发。
!suite/socialsharing/umeng/sms/libs/umeng-share-sms-7.3.7.jar
!suite/socialsharing/umeng/email/libs/umeng-share-email-7.3.7.jar

# Python 校验脚本的本地字节码缓存。
__pycache__/
*.py[cod]
